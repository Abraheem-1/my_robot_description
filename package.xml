<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_robot_description</name>
  <version>0.0.0</version>
  <description>My robot description package with SLAM and Nav2</description>
  <maintainer email="todo@todo.com">abraheem</maintainer>
  <license>Apache-2.0</license>

  <!-- ================= BUILD DEPENDENCIES ================= -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ================= ROBOT DESCRIPTION ================= -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>

  <!-- ================= GAZEBO ================= -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>

  <!-- ================= AWS WAREHOUSE WORLD ================= -->
  <exec_depend>aws_robomaker_small_warehouse_world</exec_depend>

  <!-- ================= SLAM ================= -->
  <exec_depend>slam_toolbox</exec_depend>

  <!-- ================= NAV2 ================= -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>navigation2</exec_depend>

  <!-- ================= TF ================= -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_tools</exec_depend>

  <!-- ================= VISUALIZATION ================= -->
  <exec_depend>rviz2</exec_depend>

  <!-- ================= TELEOP ================= -->
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- ================= TEST ================= -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>